# 台灣吃喝玩樂 環境變數設定範例
APP_ENV=development
APP_PORT=8081

# 交通部觀光署 Open Data API (TDX / 觀光資訊資料庫)
TAIWAN_TOURISM_API_KEY=your_taiwan_tourism_api_key_here
TAIWAN_TDX_CLIENT_ID=your_tdx_client_id_here
TAIWAN_TDX_CLIENT_SECRET=your_tdx_client_secret_here

# Google Places API (用於評分星等與即時營業狀態)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# 資料庫 (Supabase / PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/taiwan_travel_db

# 分潤聯盟設定 (Affiliate Tracking)
KLOOK_AFFILIATE_AID=123436
KKDAY_AFFILIATE_CID=123436
AGODA_AFFILIATE_CID=123436

